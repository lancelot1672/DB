# DATA_MIG environment
# Copy to MIG.env  (cp MIG.env.example MIG.env)  and fill in.
# MIG.env is gitignored (repo .gitignore = *.env). Never hardcode credentials in scripts.

# ORACLE (sqlplus) | TIBERO (tbsql) : DB where DBADM.DBM_MIG_MSTR lives
DB_TYPE=ORACLE

DB_USER=dbadm
DB_PASS=changeme
# Optional connect identifier (Oracle TNS alias / Tibero tbdsn alias). Empty = local default
DB_TNS=

# 02.RUN_MIG.sh : migrate DBM_MIG_MSTR rows of this MSTR_ID (MIG_YN = 'Y')
MSTR_ID=20260914

# 02.RUN_MIG.sh : seconds between "Running" lines in the progress log while one table runs
HEARTBEAT_SEC=300

# 02.RUN_MIG.sh : Y = run / retry regenerate each table's SQL from DBM_MIG_MSTR (+ COL_MAP) right before it runs
#   (cmd/<PHASE>/*.out overwritten, changed file -> .bak, no longer a target -> SKIP) ; N or empty = run the .out as it is
SQL_REFRESH=N

# Source DB LINK name used in migration SQL (FROM OWNER.TABLE@SRC_DBLINK). DBM_MIG_MSTR.SRC(=ASIS) is only a label
SRC_DBLINK=ASIS_LINK

# Working base path. log/ and tmp/ are created under here automatically.
BASE_PATH=/home/oracle/data_mig

# 02.RUN_MIG.sh : launcher sh of background workers are written to $MIG_HOME/run (empty = script directory)
MIG_HOME=

# 02.RUN_MIG.sh : colour on the terminal (log files stay plain) : empty = auto, Y = force (| less -R), N = off
MIG_COLOR=

# CSV with Korean values : client charset must match the CSV encoding
# export NLS_LANG=AMERICAN_AMERICA.AL32UTF8      # ORACLE
# export TB_NLS_LANG=UTF8                        # TIBERO
