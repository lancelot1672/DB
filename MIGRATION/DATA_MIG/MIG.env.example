# DATA_MIG environment
# Copy to MIG.env  (cp MIG.env.example MIG.env)  and fill in.
# MIG.env is gitignored (repo .gitignore = *.env). Never hardcode credentials in scripts.

# ORACLE (sqlplus) | TIBERO (tbsql) : DB where DBADM.DBM_MIG_MSTR lives
DB_TYPE=ORACLE

DB_USER=dbadm
DB_PASS=changeme
# Optional connect identifier (Oracle TNS alias / Tibero tbdsn alias). Empty = local default
DB_TNS=

# 02.RUN_MIG.sh : migrate DBM_MIG_MSTR rows of this MSTR_ID (MIG_YN = 'Y')
MSTR_ID=20260914

# 02.RUN_MIG.sh : seconds between "Running" lines in the progress log while one table runs
HEARTBEAT_SEC=300

# 02.RUN_MIG.sh : Y = run / retry regenerate each table's SQL from DBM_MIG_MSTR (+ COL_MAP) right before it runs
#   (cmd/<PHASE>/*.out overwritten, changed file -> .bak, no longer a target -> SKIP) ; N or empty = run the .out as it is
SQL_REFRESH=N

# 02.RUN_MIG.sh : DBM_MIG_MSTR column that holds the condition column name (default COL_CONDITION)
#   PRE_COND_COL  : used by the PRE 1st / 2nd step , DDAY_COND_COL : used by DDAY
#   e.g. add COL_CONDITION2 to DBM_MIG_MSTR and set DDAY_COND_COL=COL_CONDITION2 to use another column for DDAY
PRE_COND_COL=COL_CONDITION
DDAY_COND_COL=COL_CONDITION

# the comparison operators are fixed and can not be changed : 1st {col} >= 'PRE1' AND < 'PRE2' ,
# 2nd {col} >= 'PRE2' AND < 'PRE3' , DDAY {col} >= 'PRE3' (the steps join at PRE2 / PRE3 without gap or overlap)

# 02.RUN_MIG.sh : [R] 1 / 4 Generate splits a date condition into chunk SQL files (NONE or empty = one file per table)
#   SPLIT_UNIT=DAY|MONTH|YEAR , SPLIT_SIZE=n (e.g. MONTH + 3 = every 3 months)
#   1st : [PRE1, PRE2) , 2nd : [PRE2, PRE3) , DDAY : [PRE3, today] + open last chunk
#   date format taken from the PRE value (20250101, 2025-01-01, 202501 ...) ; NONE = no split (one .out per table)
#   needs DBM_XDN_LOG.CHUNK_NO / CHUNK_COND (DDL_Script/DBM_XDN_LOG.sql)
SPLIT_UNIT=MONTH
SPLIT_SIZE=1

# Source DB LINK name used in migration SQL (FROM OWNER.TABLE@SRC_DBLINK). DBM_MIG_MSTR.SRC(=ASIS) is only a label
SRC_DBLINK=ASIS_LINK

# The one working path of 01 / 02 / 03. Empty = the directory of the scripts.
#   ${MIG_HOME}/cmd  migration SQL (.out)        ${MIG_HOME}/log  logs (load, migration, integrated)
#   ${MIG_HOME}/tmp  temp SQL and DB output      ${MIG_HOME}/run  launcher sh of background workers
# The directories are created automatically. MIG_HINT.conf stays next to the scripts.
MIG_HOME=

# 02.RUN_MIG.sh : colour on the terminal (log files stay plain) : empty = auto, Y = force (| less -R), N = off
MIG_COLOR=

# CSV with Korean values : client charset must match the CSV encoding
# export NLS_LANG=AMERICAN_AMERICA.AL32UTF8      # ORACLE
# export TB_NLS_LANG=UTF8                        # TIBERO
