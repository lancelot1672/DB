# DATA_MIG_VERIFY environment
# Copy to VERIFY.env  (cp VERIFY.env.example VERIFY.env)  and fill in.
# Never hardcode credentials in the shell scripts.

# ------------------------------------------------------------
# TOBE (TARGET) : control tables live here
#   DBADM.DBM_MIG_MSTR / DBM_MIG_COL_MAP / DBM_MIG_PRE_DATA_VERIFY
#   the verify result is INSERTed here
# ------------------------------------------------------------
TOBE_DB_TYPE=TIBERO
TOBE_DB_USER=dbadm
TOBE_DB_PASS=changeme
# Optional connect identifier (Oracle TNS alias / Tibero tbdsn alias). Empty = local default
TOBE_DB_TNS=

# ------------------------------------------------------------
# ASIS (SOURCE)
# ------------------------------------------------------------
ASIS_DB_TYPE=ORACLE
ASIS_DB_USER=dbadm
ASIS_DB_PASS=changeme
ASIS_DB_TNS=

# ------------------------------------------------------------
# Verify target
# ------------------------------------------------------------
# DBM_MIG_MSTR.MSTR_ID to verify (MIG_YN = 'Y' rows only)
MSTR_ID=20260914

# MIG_TYPE to verify, comma separated
#   PRE  : condition rows  -> WHERE {COL_CONDITION} >= 'PRE1' AND {COL_CONDITION} < 'PRE2'
#   DDAY : full rows       -> no condition (whole table)
#   DDAY tables are only migrated on D-day, so before D-day they are 불일치 by nature :
#   keep PRE alone until D-day, and add DDAY when the D-day load is over
MIG_TYPE_LIST=PRE

# max NUMBER columns compared per table (target ALL_TAB_COLUMNS, COLUMN_ID order)
MAX_NUM_COLS=10

# ALL_TAB_COLUMNS.DATA_TYPE treated as a number column, comma separated (default NUMBER)
#   add FLOAT / BINARY_DOUBLE / BINARY_FLOAT here when those columns must be compared too
NUM_DATA_TYPES=NUMBER

# Y = also compare COUNT(*) as one extra row (COLUMN_NAME = *ROW_COUNT*)
COUNT_CHECK=Y

# comparison operators of the PRE condition ( > , >= , < , <= ). Empty / wrong value = default
#   PRE : {col} PRE1_OP 'PRE1' AND {col} PRE2_OP 'PRE2'     default : >= PRE1 AND < PRE2
#   quote the symbols ( PRE1_OP='>=' ) : this file is read by the shell, so >= without quotes is a redirection
#   GE / GT / LE / LT may be used instead ( GE = >= , GT = > , LE = <= , LT = < )
PRE1_OP='>='
PRE2_OP='<'

# DBM_MIG_MSTR column that holds the condition column name (default COL_CONDITION)
PRE_COND_COL=COL_CONDITION

# ------------------------------------------------------------
# Execution
# ------------------------------------------------------------
# tables verified at the same time (1 = sequential). Each table opens 2 DB sessions (ASIS + TOBE)
WORKER_DEGREE=4

# SELECT /*+ PARALLEL(n) */ degree of the SUM query (0 or 1 = no hint)
PARALLEL_DEGREE=2

# Working base path. log/ , tmp/ , cmd/ are created under here automatically
BASE_PATH=/home/oracle/data_mig_verify

# ------------------------------------------------------------
# Number formatting (optional)
# ------------------------------------------------------------
# TO_CHAR format model for the SUM value. Empty (default) = TO_CHAR(SUM(col)) as the DB prints it.
#   Set it when ASIS and TOBE print the same value differently (Oracle <-> Tibero), e.g. SUM_FMT=TM9
SUM_FMT=

# ROUND(SUM(col), n) before comparing. Empty (default) = no rounding.
#   Use it when FLOAT / BINARY_DOUBLE style columns differ only in the last digits, e.g. SUM_ROUND=2
SUM_ROUND=

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
# colour on the terminal (log files stay plain) : empty = auto, Y = force, N = off
VERIFY_COLOR=

# CSV / Korean values : client charset must match the DB
# export NLS_LANG=AMERICAN_AMERICA.AL32UTF8      # ORACLE
# export TB_NLS_LANG=UTF8                        # TIBERO
