# Oracle client environment for the load module of 00.P2O_MENU.sh with TARGET_DBMS=ORACLE (sqlplus + sqlldr)
# Copy to env/ORACLE.env  (cp env/ORACLE.env.example env/ORACLE.env)  and set the install path of this server.
# Sourced by bash from 00.P2O_MENU.sh (load module / Target connection test) when ORACLE_ENV_FILE in P2O.env points to it.
# No credentials here : the target account / password are typed in at start.

# full client : ORACLE_HOME/bin , ORACLE_HOME/lib
# instant client (+ Tools package for sqlldr) : ORACLE_HOME=<instantclient dir> , PATH / LD_LIBRARY_PATH = ${ORACLE_HOME}
export ORACLE_HOME=/u01/app/oracle/product/19c/client_1
export PATH=${ORACLE_HOME}/bin:${PATH}
export LD_LIBRARY_PATH=${ORACLE_HOME}/lib:${LD_LIBRARY_PATH}

# tnsnames.ora location (for DB_TNS in P2O.env). Default = ${ORACLE_HOME}/network/admin
# export TNS_ADMIN=${ORACLE_HOME}/network/admin

# client charset : must match the CSV (always UTF8)
export NLS_LANG=AMERICAN_AMERICA.AL32UTF8
