# Tibero client environment for the load module of P2O.sh with TARGET_DBMS=TIBERO (tbsql + tbloader)
# Copy to env/TIBERO.env  (cp env/TIBERO.env.example env/TIBERO.env)  and set the install path of this server.
# Sourced by bash from P2O.sh (load module / Target connection test) when TIBERO_ENV_FILE in P2O.env points to it.
# No credentials here : the target account / password are typed in at start.

export TB_HOME=/home/tibero/tibero7
export PATH=${TB_HOME}/bin:${TB_HOME}/client/bin:${PATH}
export LD_LIBRARY_PATH=${TB_HOME}/lib:${TB_HOME}/client/lib:${LD_LIBRARY_PATH}

# tbdsn.tbr (for DB_TNS in P2O.env) is read from ${TB_HOME}/client/config

# client charset : must match the CSV (always UTF8)
export TB_NLS_LANG=UTF8
