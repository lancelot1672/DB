# PostgreSQL client environment for the unload module of P2O.sh (psql)
# Copy to env/PG.env  (cp env/PG.env.example env/PG.env)  and set the install path of this server.
# Sourced by bash from P2O.sh (unload module / Source connection test) when PG_ENV_FILE in P2O.env points to it.
# No credentials here : the PG account / password are typed in at start.

export PG_HOME=/usr/pgsql-16
export PATH=${PG_HOME}/bin:${PATH}
export LD_LIBRARY_PATH=${PG_HOME}/lib:${LD_LIBRARY_PATH}
