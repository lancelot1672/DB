# P2O_MIG environment
# Copy to P2O.env  (cp P2O.env.example P2O.env)  and fill in.
# P2O.env is gitignored (repo .gitignore = *.env). Never hardcode credentials in scripts.
# Account / password are NOT kept here : the unload / load modules of 00.P2O_MENU.sh ask for them at start (password not echoed).

# --- Client environment files (PG_HOME / ORACLE_HOME / TB_HOME, PATH, LD_LIBRARY_PATH, NLS) ---
# Sourced before the client check : unload -> PG_ENV_FILE , load -> ORACLE_ENV_FILE or TIBERO_ENV_FILE (by TARGET_DBMS)
# Relative path = from the script directory. Templates : env/*.env.example (cp to env/*.env).
# Empty = use the PATH of the current shell as it is.
PG_ENV_FILE=env/PG.env
ORACLE_ENV_FILE=env/ORACLE.env
TIBERO_ENV_FILE=env/TIBERO.env

# --- Source : PostgreSQL (unload module, psql) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=postgres

# --- Target : Oracle / Tibero (load module) ---
# ORACLE (sqlplus + sqlldr) | TIBERO (tbsql + tbloader)
TARGET_DBMS=ORACLE

# Optional connect identifier (Oracle TNS alias / Tibero tbdsn alias). Empty = local default
DB_TNS=

# The one working path of the unload / load modules. Empty = the directory of the scripts.
#   ${BASE_PATH}/csv  unloaded CSV files          ${BASE_PATH}/ctl  loader control files
#   ${BASE_PATH}/bad  rejected rows               ${BASE_PATH}/log  script + loader logs
#   ${BASE_PATH}/tmp  temp SQL and DB output
# The directories are created automatically. Extract SQL files stay in ./sql next to the scripts.
BASE_PATH=

# unload : rows per CSV chunk file. 0 = one CSV file (csv/<SQL_NAME>.csv)
#   > 0 : the one COPY stream is split into csv/<SQL_NAME>/<SQL_NAME>_00001.csv ... (header in every chunk)
UNLOAD_CHUNK_ROWS=0

# load : rows per load chunk for a single CSV. 0 = load the file in one loader run
#   > 0 : the CSV is split into tmp chunks, loaded and checked one by one (resume from a failed chunk)
#   a chunk directory made by unload is always loaded chunk by chunk (this value is then ignored)
LOAD_CHUNK_ROWS=0

# load : loader rows= (rows per commit / data save). Empty = loader default
LOAD_COMMIT_ROWS=

# load : APPEND = add to the existing rows , TRUNCATE = empty the table first (not recoverable)
#   with chunks, TRUNCATE applies to the 1st chunk only (a resumed run never truncates)
LOAD_MODE=APPEND

# load : Y = direct path load , N = conventional
DIRECT=N

# load : the loader stops after this many rejected rows (per loader run = per chunk)
LOAD_ERRORS=50

# load : character set of the CSV, written to the control file (CSV is always unloaded as UTF8)
#   empty = AL32UTF8 (ORACLE) / UTF8 (TIBERO)
#   client charset (NLS_LANG / TB_NLS_LANG) is set in env/ORACLE.env / env/TIBERO.env
CHARSET=
